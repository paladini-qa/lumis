# =========================================================================
# Lumis - Local Development Environment Variables Template
# Copy this file to a new file named '.env' and populate with your settings:
# cp .env.example .env
# =========================================================================

# 1. CLIENT-SIDE EXPO VARIABLES (Exposed in JS bundle for Web and Mobile)
# Populate these with your local Supabase credentials (from 'supabase start')
# or your production Supabase project details.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. LOCAL TESTING DEV TOOL KEYS (Never check real keys into version control)
# Stored locally to allow Gradle builds and Supabase Edge Function testing.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:6543/postgres
GEMINI_API_KEY=AIzaSy...
